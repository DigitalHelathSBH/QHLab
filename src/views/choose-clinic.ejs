<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>เลือกคลินิก - ปริ้นบัตรคิว</title>
<link rel="stylesheet" href="<%= basePath %>/css/style.css" />
</head>
<body>
  <main class="search-box">
    <h1>เลือกคลินิก</h1>
    <p class="today">
      HN <%= hn %> พบคิววันนี้มากกว่า 1 คลินิก กรุณาเลือกคลินิกที่จะปริ้นบัตรคิว
    </p>

    <div class="clinic-choices">
      <% clinics.forEach(function (c) { %>
        <a
          class="clinic-choice-btn"
          href="<%= basePath %>/print?hn=<%= encodeURIComponent(hn) %>&clinic=<%= encodeURIComponent(c.clinicCode ?? '') %>"
        >
          <span class="clinic-choice-queue"><%= c.queueNo %></span>
          <span class="clinic-choice-name">
            <% if (c.clinicCode) { %>(<%= c.clinicCode %>) <% } %><%= c.clinicName || "ไม่ทราบชื่อคลินิก" %>
          </span>
        </a>
      <% }); %>
    </div>

    <p class="hint"><a href="<%= basePath %>/">&larr; ค้นหาใหม่</a></p>
  </main>
</body>
</html>
