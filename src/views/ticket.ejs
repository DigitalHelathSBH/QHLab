<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>บัตรคิว ห้องจ่ายยา OPD</title>
<link rel="stylesheet" href="<%= basePath %>/css/style.css" />
<link rel="stylesheet" href="<%= basePath %>/css/ticket.css" />
</head>
<body>
  <div class="toolbar no-print">
    <a href="<%= basePath %>/">&larr; ค้นหาใหม่</a>
    <button onclick="window.print()">ปริ้นบัตรคิว</button>
  </div>

  <% tickets.forEach(function (ticket) { %>
  <section class="ticket">
    <div class="content">
      <h1 class="ticket-title">ห้องจ่ายยา OPD</h1>

      <div class="queue-box">
        <% if (ticket.queueLabel) { %>
          <div class="queue-label-top"><%= ticket.queueLabel %></div>
        <% } %>
        <div class="queue-no"><%= ticket.queueNo %></div>
      </div>

      <% if (ticket.barcodeDataUrl) { %>
        <img class="barcode" src="<%= ticket.barcodeDataUrl %>" alt="barcode" />
        <div class="barcode-text"><%= ticket.barcodeValue %></div>
      <% } %>

      <% if (ticket.patientName) { %>
        <div class="patient-name"><%= ticket.patientName %></div>
      <% } %>

      <div class="hospital-name"><%= ticket.hospitalName %></div>

      <% if (ticket.hn) { %>
        <div class="line">HN <%= ticket.hn %></div>
      <% } %>

      <% if (ticket.clinicName || ticket.clinicCode) { %>
        <div class="line">
          คลินิก: <% if (ticket.clinicCode) { %>(<%= ticket.clinicCode %>) <% } %><%= ticket.clinicName || "" %>
        </div>
      <% } %>

      <% if (ticket.rightName || ticket.rightCode) { %>
        <div class="line">
          สิทธิ: <% if (ticket.rightCode) { %>(<%= ticket.rightCode %>) <% } %><%= ticket.rightName || "" %>
        </div>
      <% } %>

      <% if (ticket.steps && ticket.steps.length) { %>
        <div class="steps">
          <div class="steps-title">ขั้นตอนการเข้ารับบริการ</div>
          <ol>
            <% ticket.steps.forEach(function (step) { %>
              <li><%= step %></li>
            <% }); %>
          </ol>
        </div>
      <% } %>

      <% if (ticket.note) { %>
        <div class="note">
          <div class="note-title">หมายเหตุ</div>
          <div><%= ticket.note %></div>
        </div>
      <% } %>
    </div>

    <div class="cut-line"></div>
  </section>
  <% }); %>
</body>
</html>
