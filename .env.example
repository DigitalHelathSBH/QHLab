# ---- คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามระบบจริงของ รพ. ----

# พอร์ตที่เว็บนี้จะรัน
PORT=3000

# การเชื่อมต่อ SQL Server (ssbdatabase)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=ssbdatabase
DB_USER=sa
DB_PASSWORD=changeme
# true ถ้าใช้ self-signed cert / เครื่องในวงใน, false ถ้าต้องการตรวจสอบ cert จริง
DB_TRUST_SERVER_CERTIFICATE=true
# true ถ้าต้องการเชื่อมต่อผ่าน Windows Authentication แทน user/password ด้านบน
DB_USE_WINDOWS_AUTH=false

# ชื่อโรงพยาบาลที่จะแสดงบนบัตรคิว (แก้ให้ตรงกับ รพ. ของท่าน)
HOSPITAL_NAME=โรงพยาบาลสระบุรี
